# ============================================================
# 流盾WAF (Flow Shield WAF) - 环境变量示例
# 复制为 .env 后按需修改；请务必修改所有密码与密钥
# ============================================================

# ---- SQLite（业务配置库，Docker 默认 /data/waf.db）----
DB_PATH=/data/waf.db

# ---- MySQL（仅一次性迁移脚本 migrate_mysql_to_sqlite.py 使用）----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=waf
MYSQL_USER=waf
MYSQL_PASSWORD=change_me_waf
DB_HOST=mysql
DB_PORT=3306

# ---- Redis ----
REDIS_PASSWORD=change_me_redis
# Docker Compose 默认走 Unix Socket（同机 app/redis 共享卷，比 TCP 更稳）
# 本地非 Docker 开发留空即可，自动回退 TCP：redis:6379
# REDIS_SOCKET_PATH=/var/run/redis/redis.sock
# OpenResty 连接池（可选）
# REDIS_POOL_SIZE=256
# REDIS_KEEPALIVE_MS=60000
# FastAPI 连接池上限（可选）
# REDIS_MAX_CONNECTIONS=64

# ---- 后端 (FastAPI) ----
# JWT 签名密钥，必须为长随机串
JWT_SECRET=please_change_this_to_a_long_random_secret
JWT_ACCESS_TTL_MIN=120
JWT_REFRESH_TTL_DAYS=7
# 初始管理员账号（首次启动自动创建）
WAF_ADMIN_USER=admin
WAF_ADMIN_PASSWORD=admin888
# 挑战/人机验证 cookie 的 HMAC 密钥
WAF_CHALLENGE_SECRET=please_change_this_challenge_secret
# 是否暴露 OpenAPI 文档（生产建议 false）
ENABLE_DOCS=true
# CORS 允许来源，逗号分隔；开发可用 *，生产建议留空或填面板域名
CORS_ORIGINS=*
# 开发环境允许不安全默认密钥（生产务必 false）
WAF_ALLOW_INSECURE_DEFAULTS=false

# ---- ClickHouse（防护日志存储）----
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=waf
# 高流量场景保持 true，减少 INSERT 往返
# CLICKHOUSE_ASYNC_INSERT=true
# 小时聚合物化视图：开启会增加写入开销，默认关闭
# CLICKHOUSE_HOURLY_MV_ENABLED=false
# 日志采集批量大小与单次 drain 批次数（越大 = 更少次 ClickHouse 写入）
# LOG_COLLECTOR_BATCH_SIZE=2000
# LOG_COLLECTOR_MAX_DRAIN_BATCHES=4

# ---- 面板端口（前端 + API 网关）----
PANEL_PORT=9000

# ---- WAF 引擎对外端口 ----
WAF_HTTP_PORT=80
WAF_HTTPS_PORT=443
# 源站填 localhost 时写入 Nginx 上游的宿主机网关 IP（host.docker.internal 会原样保留）
# Linux Docker 默认 172.17.0.1；Mac Docker Desktop 本地开发推荐直接填 host.docker.internal
WAF_ORIGIN_HOST_GATEWAY=172.17.0.1
