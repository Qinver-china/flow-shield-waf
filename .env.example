# ============================================================
# 流盾WAF (Flow Shield WAF) - 环境变量示例
# 复制为 .env 后即可启动；下列密钥已是可用长度，仍强烈建议改成你自己的随机值
# ============================================================

# 应用日志级别：WARNING 仅输出警告/错误（生产推荐）；开发可设为 INFO 或 DEBUG
LOG_LEVEL=WARNING

# ---- SQLite（业务配置库，Docker 默认 /data/waf.db）----
DB_PATH=/data/waf.db

# ---- 面板端口（前端 + API 网关；容器内 Nginx listen 9000）----
PANEL_PORT=9000

# ---- WAF 引擎对外监听端口 ----
WAF_HTTP_PORT=80
WAF_HTTPS_PORT=443

# ---- 额外发布到宿主机的站点监听端口 ----
# 80 / 443 / 面板端口已自动映射，不必再写。站点「修改访问监控端口」后把新端口填在这里，
# 逗号分隔，例如：EXTRA_LISTEN_PORTS=8080,8443
# 保存后执行：bash scripts/sync-compose-ports.sh && docker compose up -d
# 不要手改 docker-compose.override.yml，只改本变量。该列表只写在 .env（更新代码会保留）。
EXTRA_LISTEN_PORTS=

# ---- Redis ----
REDIS_PASSWORD=FlowShield_Redis_ChangeMe_16
# Docker Compose 默认走 TCP（REDIS_HOST=redis / REDIS_PORT=6379）
# 可选：同机 Unix Socket（设置后优先于 TCP）
# REDIS_SOCKET_PATH=/var/run/redis/redis.sock
# OpenResty 连接池（可选）
# REDIS_POOL_SIZE=256
# REDIS_KEEPALIVE_MS=60000
# FastAPI 连接池上限（可选）
# REDIS_MAX_CONNECTIONS=64

# ---- 后端 (FastAPI) ----
# JWT 签名密钥（请改成你自己的长随机串）
JWT_SECRET=FlowShield_JWT_ChangeMe_ToYourOwnSecret_32b
JWT_ACCESS_TTL_MIN=120
JWT_REFRESH_TTL_DAYS=3
# 挑战/人机验证 cookie 的 HMAC 密钥（请改成你自己的长随机串）
WAF_CHALLENGE_SECRET=FlowShield_Challenge_ChangeMe_Secret32
# 是否暴露 OpenAPI 文档（生产建议 false）
ENABLE_DOCS=true
# CORS 允许来源，逗号分隔；开发可用 *，生产建议留空或填面板域名
CORS_ORIGINS=*

# ---- ClickHouse（防护日志存储）----
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=waf
# 高流量场景保持 true，减少 INSERT 往返
# CLICKHOUSE_ASYNC_INSERT=true
# 小时聚合物化视图：开启会增加写入开销，默认关闭
# CLICKHOUSE_HOURLY_MV_ENABLED=false
# 日志采集批量大小与单次 drain 批次数（越大 = 更少次 ClickHouse 写入）
# LOG_COLLECTOR_BATCH_SIZE=2000
# LOG_COLLECTOR_MAX_DRAIN_BATCHES=4

# 源站填 localhost 时写入 Nginx 上游的宿主机网关 IP（host.docker.internal 会原样保留）
# Linux Docker 默认 172.17.0.1；Mac Docker Desktop 本地开发推荐直接填 host.docker.internal
WAF_ORIGIN_HOST_GATEWAY=172.17.0.1

# ---- 国内构建加速（可选）----
# 手动 docker compose build 若要用国内源，取消下面注释即可（海外请保持注释）。
# 写入后请一直用这一组地址，不要命令行再换另一个源，否则 apk 层缓存会失效。
# FSWAF_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# FSWAF_PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
# FSWAF_ALPINE_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/alpine
# FSWAF_NPM_REGISTRY=https://registry.npmmirror.com
# FSWAF_CARGO_REGISTRY=sparse+https://mirrors.tuna.tsinghua.edu.cn/crates.io-index/
