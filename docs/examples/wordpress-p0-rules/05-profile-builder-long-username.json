    "conditions": [
      {
        "field": "http.method",
        "op": "eq",
        "value": "POST"
      },
      {
        "logic": "or",
        "conditions": [
          {
            "logic": "and",
            "conditions": [
              {
                "field": "http.body.form",
                "arg": "username",
                "op": "len_gt",
                "value": 60
              },
              {
                "field": "http.body.form",
                "arg": "username",
                "op": "len_lt",
                "value": 71
              }
            ]
          },
          {
            "logic": "and",
            "conditions": [
              {
                "field": "http.body.json",
                "arg": "username",
                "op": "len_gt",
                "value": 60
              },
              {
                "field": "http.body.json",
                "arg": "username",
                "op": "len_lt",
                "value": 71
              }
            ]
          }
        ]
      }
    ]
  }
