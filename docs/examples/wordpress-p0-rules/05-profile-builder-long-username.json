  "remark": "CVE-2026-15826：注册用户名 61–70 字符可能被收成用户 ID 1。WordPress 核心用户名最长 60。Profile Builder ≤3.16.4 风险最高。补丁 3.16.5。",
  "mode": "observe",
  "priority": 32,
  "site_ids": [],
  "enabled": true,
  "custom_block_page_enabled": false,
